<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!--
         The managed hackathon build needs a complete launcher-app catalog.
         This broad visibility is deliberately absent from main/release.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!--
         Firebase Local Emulator Suite uses HTTP. This debug-only application
         override permits Android Emulator access through 10.0.2.2; release
         builds continue to inherit the cleartext-safe main manifest.
    -->
    <application android:usesCleartextTraffic="true" />
</manifest>
